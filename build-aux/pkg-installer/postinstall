#!/bin/bash
set -e

# Rootd-only setup. The CLI postinstall owns the machine-wide config
# directory; this script just ensures the cache directory exists and
# loads the launchd job.

mkdir -p "/Library/Caches/telepresence"
chown -R root:wheel "/Library/Caches/telepresence"
chmod 755 "/Library/Caches/telepresence"

# On upgrade an instance of the daemon is still loaded with the previous
# binary; `launchctl load` is a no-op in that case, so the new binary
# would never start. Unload first (best-effort — fails harmlessly on a
# fresh install where nothing is loaded yet), then load.
echo "Restarting Telepresence Root Daemon..."
/bin/launchctl unload /Library/LaunchDaemons/io.telepresence.rootd.plist 2>/dev/null || true
/bin/launchctl load -w /Library/LaunchDaemons/io.telepresence.rootd.plist

echo "Telepresence Root Daemon is running."
echo "Control with: telepresence-rootd start|stop|restart"
