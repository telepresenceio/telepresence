# RBAC for installing Telepresence VERSION with telepresence helm install.
# Generated by telepresence rbac generate install --verbs install for manager namespace ambassador,
# values: the chart defaults.
# Subjects: User:alice.
# Generated with --all, without looking at the cluster: this is the complete set, assuming nothing exists yet.
#
# The chart's Roles and ClusterRoles can only be created by someone who holds what they grant,
# so this gives the installer everything the traffic-manager holds. In a cluster-wide install that
# means pod logs, evictions, workload patch, token reviews and access reviews in every namespace.
# Review the rules before applying them.
#
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: telepresence-install-ambassador
rules:
- apiGroups:
  - ""
  resourceNames:
  - traffic-manager
  resources:
  - configmaps
  verbs:
  - get
- apiGroups:
  - ""
  resources:
  - namespaces
  verbs:
  - create
  - get
  - list
  - watch
- apiGroups:
  - ""
  resources:
  - nodes
  verbs:
  - get
  - list
  - watch
- apiGroups:
  - ""
  resources:
  - pods
  verbs:
  - get
  - list
  - watch
- apiGroups:
  - ""
  resources:
  - pods/eviction
  verbs:
  - create
- apiGroups:
  - ""
  resources:
  - pods/log
  verbs:
  - get
- apiGroups:
  - ""
  resources:
  - services
  verbs:
  - get
  - list
  - update
  - watch
- apiGroups:
  - admissionregistration.k8s.io
  resources:
  - mutatingwebhookconfigurations
  verbs:
  - create
- apiGroups:
  - admissionregistration.k8s.io
  resourceNames:
  - agent-injector-webhook-ambassador
  resources:
  - mutatingwebhookconfigurations
  verbs:
  - delete
  - get
- apiGroups:
  - apps
  resources:
  - deployments
  verbs:
  - get
  - list
  - patch
  - watch
- apiGroups:
  - apps
  resources:
  - replicasets
  verbs:
  - get
  - list
  - patch
  - watch
- apiGroups:
  - apps
  resources:
  - statefulsets
  verbs:
  - get
  - list
  - patch
  - watch
- apiGroups:
  - authentication.k8s.io
  resources:
  - tokenreviews
  verbs:
  - create
- apiGroups:
  - authorization.k8s.io
  resources:
  - subjectaccessreviews
  verbs:
  - create
- apiGroups:
  - events.k8s.io
  resources:
  - events
  verbs:
  - get
  - watch
- apiGroups:
  - networking.k8s.io
  resources:
  - ingresses
  verbs:
  - get
  - list
  - watch
- apiGroups:
  - networking.k8s.io
  resources:
  - servicecidrs
  verbs:
  - get
  - list
  - watch
- apiGroups:
  - rbac.authorization.k8s.io
  resources:
  - clusterrolebindings
  verbs:
  - create
- apiGroups:
  - rbac.authorization.k8s.io
  resourceNames:
  - traffic-manager-ambassador
  resources:
  - clusterrolebindings
  verbs:
  - delete
  - get
- apiGroups:
  - rbac.authorization.k8s.io
  resources:
  - clusterroles
  verbs:
  - create
- apiGroups:
  - rbac.authorization.k8s.io
  resourceNames:
  - traffic-manager-ambassador
  resources:
  - clusterroles
  verbs:
  - delete
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: telepresence-install-ambassador
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: telepresence-install-ambassador
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: alice
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: telepresence-install-ambassador
  namespace: ambassador
rules:
- apiGroups:
  - ""
  resources:
  - configmaps
  verbs:
  - create
- apiGroups:
  - ""
  resourceNames:
  - traffic-manager
  resources:
  - configmaps
  verbs:
  - delete
- apiGroups:
  - ""
  resourceNames:
  - traffic-manager
  - traffic-manager-install
  resources:
  - configmaps
  verbs:
  - get
  - list
  - patch
  - update
  - watch
- apiGroups:
  - ""
  resources:
  - secrets
  verbs:
  - create
  - get
  - list
  - update
- apiGroups:
  - ""
  resourceNames:
  - mutator-webhook-tls
  resources:
  - secrets
  verbs:
  - watch
- apiGroups:
  - ""
  resourceNames:
  - mutator-webhook-tls
  - sh.helm.release.v1.traffic-manager.v1
  resources:
  - secrets
  verbs:
  - delete
- apiGroups:
  - ""
  resources:
  - serviceaccounts
  verbs:
  - create
- apiGroups:
  - ""
  resourceNames:
  - traffic-manager
  resources:
  - serviceaccounts
  verbs:
  - delete
  - get
- apiGroups:
  - ""
  resources:
  - services
  verbs:
  - create
- apiGroups:
  - ""
  resourceNames:
  - agent-injector
  - traffic-manager
  - traffic-manager-headless
  resources:
  - services
  verbs:
  - delete
  - get
- apiGroups:
  - apps
  resources:
  - statefulsets
  verbs:
  - create
- apiGroups:
  - apps
  resourceNames:
  - traffic-manager
  resources:
  - statefulsets
  verbs:
  - delete
  - get
- apiGroups:
  - rbac.authorization.k8s.io
  resources:
  - rolebindings
  verbs:
  - create
- apiGroups:
  - rbac.authorization.k8s.io
  resourceNames:
  - agent-injector-webhook-secret
  - traffic-manager
  resources:
  - rolebindings
  verbs:
  - delete
  - get
- apiGroups:
  - rbac.authorization.k8s.io
  resources:
  - roles
  verbs:
  - create
- apiGroups:
  - rbac.authorization.k8s.io
  resourceNames:
  - agent-injector-webhook-secret
  - traffic-manager
  resources:
  - roles
  verbs:
  - delete
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: telepresence-install-ambassador
  namespace: ambassador
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: telepresence-install-ambassador
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: alice
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: telepresence-install-ambassador
  namespace: kube-system
rules:
- apiGroups:
  - rbac.authorization.k8s.io
  resources:
  - rolebindings
  verbs:
  - create
- apiGroups:
  - rbac.authorization.k8s.io
  resourceNames:
  - traffic-manager-x509-auth-ambassador
  resources:
  - rolebindings
  verbs:
  - delete
  - get
- apiGroups:
  - rbac.authorization.k8s.io
  resourceNames:
  - extension-apiserver-authentication-reader
  resources:
  - roles
  verbs:
  - bind
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: telepresence-install-ambassador
  namespace: kube-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: telepresence-install-ambassador
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: alice
