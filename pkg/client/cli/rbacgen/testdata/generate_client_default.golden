# RBAC for using Telepresence VERSION with the traffic-manager in namespace ambassador.
# Generated by telepresence rbac generate client from the given values.
# Subjects: User:alice.
# The traffic-manager is cluster-wide, so the namespace rules are granted in every namespace.
#
# These objects aren't managed by Helm, and their names don't collide with the ones the
# chart creates for clientRbac. Review the rules before applying them.
#
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: telepresence-client-ambassador
rules:
- apiGroups:
  - ""
  resources:
  - namespaces
  verbs:
  - get
  - list
  - watch
- apiGroups:
  - ""
  resources:
  - pods
  verbs:
  - get
  - list
- apiGroups:
  - ""
  resources:
  - pods/log
  verbs:
  - get
- apiGroups:
  - telepresence.io
  resources:
  - logs
  - logs/yaml
  verbs:
  - get
- apiGroups:
  - ""
  resources:
  - pods/portforward
  verbs:
  - create
- apiGroups:
  - telepresence.io
  resources:
  - attachments
  verbs:
  - create
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: telepresence-client-ambassador
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: telepresence-client-ambassador
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: alice
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: telepresence-client-ambassador-connect
  namespace: ambassador
rules:
- apiGroups:
  - ""
  resources:
  - pods
  verbs:
  - get
  - list
- apiGroups:
  - ""
  resourceNames:
  - traffic-manager
  resources:
  - services
  verbs:
  - get
- apiGroups:
  - ""
  resources:
  - pods/portforward
  verbs:
  - create
- apiGroups:
  - telepresence.io
  resources:
  - connections
  verbs:
  - create
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: telepresence-client-ambassador-connect
  namespace: ambassador
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: telepresence-client-ambassador-connect
subjects:
- apiGroup: rbac.authorization.k8s.io
  kind: User
  name: alice
